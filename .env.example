# Copy to .env and fill in. .env is gitignored: it holds secrets.
# Django reads it (backend/gateway/settings.py), the containers get it (env_file), and
# docker-compose.yml takes the GATEWAY_*, MINI_DIR and VITE_* values from it.

# Development: True. Production: False (then DJANGO_SECRET_KEY is required).
DJANGO_DEBUG=False
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# The host names Django answers to. In Docker, GATEWAY_HOST below replaces this.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Where the SQLite database lives (default: <repo>/data). The containers always use /data
# (docker-compose.yml), which is ./data, the production catalog. For a development server on
# the same machine, point it at another folder, as an absolute path:
# DATA_DIR=/path/to/projects-gateway/data/dev

# The app's public address, for the links in notifications.
SITE_URL=https://projects.example.com

# Login: an OAuth 2 auth server (Authorization Code + PKCE). The backend checks every request's
# token at its userinfo endpoint; the frontend needs the server's base URL and the app's public
# client ID (no secret). Its endpoints are expected at /o/authorize/, /o/token/, /o/userinfo/
# and /o/revoke_token/ (django-oauth-toolkit's layout).
OAUTH2_USERINFO_ENDPOINT=https://auth.example.com/o/userinfo/
VITE_AUTH_SERVER_BASE=https://auth.example.com
VITE_OAUTH_CLIENT_ID=

# Docker Compose: the public host name, the uid and gid the containers run as (the owner of
# ./data on the host: `id -u`, `id -g`), the port published on 127.0.0.1, and where mini is.
GATEWAY_HOST=projects.example.com
GATEWAY_UID=1000
GATEWAY_GID=1000
# GATEWAY_PORT=8040
# MINI_DIR=../mini

# GitHub sync: a fine-grained, read-only token (Metadata), repos under GITHUB_OWNER only.
GITHUB_OWNER=
GITHUB_TOKEN=
# GITHUB_SYNC_HOURS=6

# Live status (the worker): every public URL checked every HEALTH_CHECK_MINUTES.
# HEALTH_CHECK_MINUTES=15

# The host scan (deploy/scan_local.py): the slug of the catalog platform it describes.
# SCAN_PLATFORM=home-server

# Security alerts (the host scan): the SSH keys allowed to log into the server, comma-separated,
# as `ssh-keygen -lf ~/.ssh/authorized_keys` prints them. Any other key in an authorized_keys
# file, or used to log in, is red. Events before SECURITY_SINCE (ISO 8601 with its offset) are
# ignored. Not public, but not secret either: fingerprints.
# SSH_KNOWN_KEYS=SHA256:…,SHA256:…
# SECURITY_SINCE=2026-01-01T00:00:00+01:00

# Notifications: one message when something in "Needs attention" turns red, and one when it
# clears, through every channel set up here (none set up: nothing is sent). Test with
# `manage.py notify_test`. The containers read .env when created: `docker compose up -d`.
#
# Telegram: create a bot with @BotFather (/newbot) and put its token here. Send the bot any
# message, then run notify_test: it prints your chat ID for TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email through SMTP: a mailbox to send from, and its password. Port 465 is SSL, 587 STARTTLS.
# NOTIFY_EMAIL_TO takes one address or several, comma-separated.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
NOTIFY_EMAIL_TO=
